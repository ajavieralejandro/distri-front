# Variante local de pruebas internas. No es un servidor público.
# La dirección inicial es solo el valor de arranque; se cambia en Conexión.
# Una página HTTPS no puede llamar a esta API HTTP.
VITE_API_URL=http://127.0.0.1:3010/api
VITE_APP_ENV=development
VITE_DATA_SOURCE=api
VITE_DEMO_MODE=false
VITE_ALLOW_CLEARTEXT=true
