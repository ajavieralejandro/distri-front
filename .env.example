# Origen de datos
# mock = MSW + fixtures (demo). api = backend real (sin fallback a mock).
VITE_API_URL=http://localhost:3000/api
VITE_APP_ENV=development
VITE_DATA_SOURCE=mock
VITE_DEMO_MODE=true
# browser | hash — omitir para inferir desde Vite base
# VITE_ROUTER_MODE=browser

# Producción / API real (ejemplo):
# VITE_APP_ENV=production
# VITE_DATA_SOURCE=api
# VITE_DEMO_MODE=false

# GitHub Pages: usar `npm run build:pages` (lee `.env.pages`)
